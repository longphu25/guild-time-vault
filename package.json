{
  "name": "builder-scaffold",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.17",
  "scripts": {
    "fmt": "prettier --write \"move-contracts/**/*.move\"",
    "fmt:ts": "prettier --write \"ts-scripts/**/*.ts\"",
    "fmt:check": "prettier --check \"move-contracts/**/*.move\" \"ts-scripts/**/*.ts\"",
    "lint": "sh scripts/lint-move.sh",
    "configure-rules": "bun ts-scripts/smart_gate_extension/configure-rules.ts",
    "authorise-gate-extension": "bun ts-scripts/smart_gate_extension/authorise-gate-extension.ts",
    "authorise-storage-unit-extension": "bun ts-scripts/smart_gate_extension/authorise-storage-unit-extension.ts",
    "issue-tribe-jump-permit": "bun ts-scripts/smart_gate_extension/issue-tribe-jump-permit.ts",
    "jump-with-permit": "bun ts-scripts/smart_gate_extension/jump-with-permit.ts",
    "collect-corpse-bounty": "bun ts-scripts/smart_gate_extension/collect-corpse-bounty.ts",
    "vault:init": "bun ts-scripts/guild_time_vault/init-vault.ts",
    "vault:grant-member": "bun ts-scripts/guild_time_vault/grant-member.ts",
